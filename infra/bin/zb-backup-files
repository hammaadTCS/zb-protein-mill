#!/usr/bin/env bash
# zb-backup-files – encrypted backup of uploaded slips and receipts (BR-OPS-01).
#
# Runs daily as user zbbackup (zb-mill-backup-files.timer).
# Uploads are never deleted or changed by the app, so an incremental chain is safe:
#   - the first run of each month makes a FULL archive (every file uploaded so far);
#   - later runs that month add only new files (GNU tar --listed-incremental).
# Restore = the month's full archive, then each incremental in name order (zb-restore does this).
# The tar snapshot is only advanced after a successful upload, so a failed run is repeated next time.
set -Eeuo pipefail
umask 077

LIB="$(dirname "$(readlink -f "$0")")/zb-lib.sh"
[ -r "$LIB" ] || LIB=/usr/local/lib/zb-mill/zb-lib.sh
# shellcheck source=zb-lib.sh
source "$LIB"
zb_load_config ENV_NAME UPLOADS_DIR BACKUP_WORK_DIR BACKUP_RECIPIENTS_FILE RCLONE_CONFIG_FILE RCLONE_REMOTE STATUS_DIR

TS="$(date -u +%Y%m%dT%H%M%SZ)"
MONTH="$(date -u +%Y-%m)"
SNAR="$BACKUP_WORK_DIR/uploads-$MONTH.snar"
if [ -f "$SNAR" ]; then KIND=incr; else KIND=full; fi
NAME="$ENV_NAME-files-$TS-$KIND.tar.age"
TMP="$BACKUP_WORK_DIR/$NAME.partial"

SUCCESS=0
on_exit() {
    local rc=$?
    [ "$SUCCESS" -eq 1 ] && return 0
    local msg="uploads backup failed (exit code $rc, see: journalctl -u zb-mill-backup-files)"
    rm -f "$TMP" "$SNAR.new" "$BACKUP_WORK_DIR/tar.rc"
    zb_write_status backup-files "{\"kind\":\"files\",\"result\":\"failure\",\"finished_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"error\":\"$(zb_json_escape "$msg")\"}"
    zb_hc_ping backup-files fail "$msg"
    zb_log "$msg"
}
trap on_exit EXIT

[ -d "$UPLOADS_DIR" ] || zb_die "uploads folder $UPLOADS_DIR does not exist"
[ -s "$BACKUP_RECIPIENTS_FILE" ] || zb_die "no backup public key in $BACKUP_RECIPIENTS_FILE"
mkdir -p "$BACKUP_WORK_DIR"
zb_hc_ping backup-files start

rm -f "$SNAR.new"
[ "$KIND" = incr ] && cp -p "$SNAR" "$SNAR.new"

# GNU tar exit code 1 means "a file changed while being read": the file is still in the next run.
{
    trap - ERR
    set +e
    tar --create --listed-incremental="$SNAR.new" --file=- \
        --directory="$(dirname "$UPLOADS_DIR")" "$(basename "$UPLOADS_DIR")"
    echo $? > "$BACKUP_WORK_DIR/tar.rc"
} | age --encrypt --recipients-file "$BACKUP_RECIPIENTS_FILE" --output "$TMP"
TAR_RC="$(cat "$BACKUP_WORK_DIR/tar.rc")"; rm -f "$BACKUP_WORK_DIR/tar.rc"
[ "$TAR_RC" -le 1 ] || zb_die "tar failed with code $TAR_RC"

zb_check_age_file "$TMP"
BYTES="$(stat -c %s "$TMP")"
zb_upload "$TMP" "$RCLONE_REMOTE/files/$MONTH/$NAME"

mv -f "$SNAR.new" "$SNAR"
# Snapshots of earlier months belong to finished chains.
find "$BACKUP_WORK_DIR" -maxdepth 1 -name 'uploads-*.snar' ! -name "uploads-$MONTH.snar" -delete
rm -f "$TMP"

SUCCESS=1
DONE="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
BODY="{\"kind\":\"files\",\"result\":\"success\",\"finished_at\":\"$DONE\",\"file\":\"$NAME\",\"bytes\":$BYTES,\"chain\":\"$MONTH\",\"type\":\"$KIND\"}"
zb_write_status backup-files "$BODY"
zb_write_status backup-files-last-success "$BODY"
zb_hc_ping backup-files "" "$NAME $BYTES bytes"
zb_log "done: $NAME ($BYTES bytes)"
