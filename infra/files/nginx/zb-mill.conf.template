# ZB Poultry Protein Mill – nginx site (BR-SEC-01, BR-SEC-14, NFR-01, NFR-11).
# Installed to /etc/nginx/sites-available/zb-mill.conf by infra/provision/steps/50-nginx-tls.sh,
# which replaces __DOMAIN__, __APP_BASE__ and __PHP_SOCK__. Written for nginx 1.28 (Ubuntu 26.04).

limit_req_zone $binary_remote_addr zone=zb_general:10m rate=20r/s;

# Access log without query strings: searches can contain party names (data-handling.md).
log_format zb_mill '$remote_addr - [$time_iso8601] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent $request_time "$http_user_agent"';

# Any request for a host name that is not ours is dropped (no certificate is shown either).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}

# Plain HTTP: Let's Encrypt challenges, everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    root __APP_BASE__/current/public;
    index index.php;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ZBSSL:10m;
    ssl_session_tickets off;

    # 5 MB file limit (BR-SEC-06) plus the other form fields.
    client_max_body_size 8m;
    client_body_timeout 30s;

    access_log /var/log/nginx/zb-mill.access.log zb_mill;
    error_log  /var/log/nginx/zb-mill.error.log warn;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    include snippets/zb-mill-headers.conf;

    # Built assets have a content hash in their names: cache for a year (NFR-11).
    location /build/ {
        include snippets/zb-mill-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; try_files $uri =404; }
    location = /robots.txt  { access_log off; try_files $uri =404; }

    # Hidden files (.env, .git) are never served, even if one appears in public/ by mistake.
    location ~ /\.(?!well-known/) {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Only the front controller runs PHP. Any other .php file is "not found".
    # Rate limit: 20 requests per second per address, bursts of 60 (enough for Inertia page loads).
    location = /index.php {
        limit_req zone=zb_general burst=60 nodelay;
        fastcgi_pass unix:__PHP_SOCK__;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTP_PROXY "";
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
    location ~ \.php$ {
        return 404;
    }
}
