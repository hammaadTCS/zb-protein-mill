# ZB Poultry Protein Mill – production and staging environment file (template).
#
# NEVER put real values in this file. It is committed to git.
# The provisioning script (infra/provision/steps/60-app-layout.sh) copies it to
# /srv/zb-mill/shared/.env on the server (owner zbdeploy, group zbmill, mode 0640) and fills in
# the values marked FILLED BY PROVISIONING. Edit the server copy only with: sudo -u zbdeploy nano
# then run: sudo zb-deploy-release --refresh-config
# Every key is explained in docs/environments.md.

APP_NAME="ZB Poultry Protein Mill"
# Staging also runs as "production" so it behaves exactly like live; ZB_ENV_NAME tells them apart.
APP_ENV=production
ZB_ENV_NAME=__ENV_NAME__
# FILLED BY PROVISIONING: 32 random bytes generated on the server. Copy it to the key holders (O-37).
APP_KEY=
# Old keys during a key change, comma separated (docs/operations/runbook.md "Change APP_KEY").
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files in storage/logs, kept 14 days, warnings and above (BR-SEC-17).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Unix socket + peer authentication: there is no database password (BR-SEC-12).
DB_CONNECTION=pgsql
DB_HOST=/var/run/postgresql
DB_PORT=5432
DB_DATABASE=zb_mill
DB_USERNAME=zb_app
DB_PASSWORD=
# Used only by "migrate --database=pgsql_migrator" during deploys (task T1.11).
DB_MIGRATOR_USERNAME=zb_migrator

# Sessions (BR-SEC-04, BR-SEC-15)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# No queue worker in version 1 (ADR-0004).
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The system sends no e-mail in version 1.
MAIL_MAILER=log

# Security headers set by the application (task T1.12).
CSP_ENABLED=true

# Read by the backup status page (task T7.6). Written by zb-backup-db / zb-backup-files.
ZB_BACKUP_STATUS_DIR=/var/lib/zb-mill/status

VITE_APP_NAME="${APP_NAME}"
