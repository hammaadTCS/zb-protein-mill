# ZB Poultry Protein Mill – production and staging environment file (template).
#
# NEVER put real values in this file. It is committed to git.
# On shared hosting you create it once by hand: `ssh <host>`, then edit
# ~/accounts/shared/.env (outside public_html, mode 0600), and fill in
# the values marked FILLED BY PROVISIONING. It is never served by the web.
# After editing, rebuild the caches: `php artisan config:cache` (or run zb-deploy-release again).
# Every key is explained in docs/environments.md.

APP_NAME="ZB Poultry Protein Mill"
# Staging also runs as "production" so it behaves exactly like live; ZB_ENV_NAME tells them apart.
APP_ENV=production
ZB_ENV_NAME=__ENV_NAME__
# FILLED BY PROVISIONING: 32 random bytes generated on the server. Copy it to the key holders (O-37).
APP_KEY=
# Old keys during a key change, comma separated (docs/operations/runbook.md "Change APP_KEY").
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://__DOMAIN__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily files in storage/logs, kept 14 days, warnings and above (BR-SEC-17).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# MariaDB on the host: ONE database user with all rights on its own database only (D-43, BR-SEC-12).
# FILLED BY PROVISIONING: the database name, user and password are created together in hPanel
# (step 2 of docs/operations/server-setup.md). The password is a strong random value; it lives in
# this file outside public_html and never in the repository.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=__DB_DATABASE__
DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=

# Sessions (BR-SEC-04, BR-SEC-15)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# No queue worker in version 1 (ADR-0004).
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The system sends no e-mail in version 1.
MAIL_MAILER=log

# Security headers set by the application (task T1.12).
CSP_ENABLED=true

# Read by the backup status page (task T7.6). Written by the `zb:backup` command.
# Backup encryption (T10.6, BR-OPS-02): the sodium public key made by infra/hostinger/make-backup-key.sh.
# The host holds ONLY this public half; it can encrypt a backup but never read one. Not a secret.
ZB_BACKUP_PUBLIC_KEY=

# Read by the backup status page (task T7.6). Written by the `zb:backup` command.
ZB_BACKUP_STATUS_DIR=/home/USER/accounts/shared/status

VITE_APP_NAME="${APP_NAME}"
